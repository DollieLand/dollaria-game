# Пример переменных окружения сервера. Подробнее — в README.md (раздел «Переменные окружения»).
# Для визуальной части есть отдельный файл frontend/.env.example

# ===== Обязательные =====
# Адрес базы PostgreSQL. На Render: страница базы → Connections → Internal Database URL
DATABASE_URL=postgresql://user:password@localhost:5432/dollaria
# Токен бота от @BotFather (команда /newbot или /token). НИКОМУ не показывайте!
BOT_TOKEN=
# Адрес игры (Render Static Site), например https://dollaria.onrender.com
WEBAPP_URL=
# С какого адреса разрешены запросы к серверу (обычно совпадает с WEBAPP_URL). Можно несколько через запятую
FRONTEND_URL=
# Адрес этого сервера (Render Web Service), нужен для команды npm run setup-bot
BACKEND_URL=
# Любая длинная случайная строка (латиница и цифры) — защищает адрес для сообщений бота
TELEGRAM_WEBHOOK_SECRET=

# ===== Настройки игры =====
NODE_ENV=production
GAME_TIMEZONE=Europe/Moscow
# Момент окончания конкурса. Куклы, полученные позже, в рейтинг не засчитываются
CONTEST_END=2026-12-31T23:59:59+03:00
# Сколько секунд действительна подпись Telegram (по умолчанию сутки)
INIT_DATA_MAX_AGE_SEC=86400
# Подключение к базе по SSL (на Render — true)
DATABASE_SSL=true

# ===== Только для разработки на своём компьютере =====
# DEV_AUTH=true позволяет войти без Telegram. В продакшене не работает.
# DEV_AUTH=true
# Подменить «сегодняшнюю» дату, чтобы проверить календарь
# GAME_DATE_OVERRIDE=2026-12-12T12:00:00+03:00
